{
    "name": "chrono",
    "version": "2.0.0",
    "description": "Chrono personal productivity and AI assistance desktop application.",
    "author": "Chrono Team <barnes.vianalen@gmail.com>",
    "main": "main/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "build:linux": "electron-builder --linux",
        "build:mac": "electron-builder --mac",
        "build:all": "electron-builder --win --linux --mac"
    },
    "devDependencies": {
        "electron": "^41.0.4",
        "electron-builder": "^26.8.1",
        "prisma": "^6.19.3"
    },
    "build": {
        "appId": "com.chrono.app",
        "productName": "Chrono",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main/**/*",
            "ui/**/*",
            "server/**/*",
            "package.json"
        ],
        "icon": "build/icon.png",
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": ["dmg", "zip"]
        },
        "linux": {
            "target": ["AppImage", "deb"],
            "category": "Utility"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Chrono"
        },
        "asar": false
    },
    "dependencies": {
        "@prisma/adapter-pg": "^6.19.3",
        "@prisma/client": "^6.19.3",
        "@supabase/supabase-js": "^2.106.2",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.8.0",
        "dotenv": "^16.6.1",
        "pg": "^8.21.0"
    }
}
